{
  "name": "@ohah/heic",
  "version": "0.2.0",
  "description": "HEIC decoding with TypeScript and WebAssembly, including main-thread and worker APIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohah/heic.git"
  },
  "files": [
    "dist",
    "vendor",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate:avc": "bun scripts/validate-avc-heic.ts",
    "validate:hevc-qp-boundary": "bun scripts/validate-ffmpeg-pr-25467.ts",
    "validate:hevc-layer-resampling": "bun scripts/validate-hevc-layer-resampling.ts",
    "validate:hevc-exbl": "bun scripts/validate-hevc-exbl.ts",
    "validate:hevc-cgs-pps": "bun scripts/validate-hevc-cgs-pps.ts",
    "validate:hevc-scalelist-inference": "bun scripts/validate-hevc-scalelist-inference.ts",
    "validate:hevc-vps-vui": "bun scripts/validate-hevc-vps-vui.ts",
    "validate:hevc-bitdepth-range": "bun scripts/validate-hevc-bitdepth-range.ts",
    "validate:hevc-mixed-depth": "bun scripts/validate-hevc-mixed-depth.ts",
    "validate:hevc-weighted-pred": "bun scripts/validate-hevc-weighted-pred.ts",
    "validate:hevc-weighted-pred-main10": "HEVC_WEIGHTED_PRED_MAIN10=1 bun scripts/validate-hevc-weighted-pred.ts",
    "validate:hevc-scc-ppi-a": "bun scripts/validate-hevc-scc-ppi-a.ts",
    "validate:hevc-scc-ppi-b": "bun scripts/validate-hevc-scc-ppi-b.ts",
    "validate:nokia-pred": "bun scripts/validate-nokia-pred.ts",
    "validate:nokia-multilayer-base": "bun scripts/validate-nokia-multilayer-base.ts",
    "validate:nokia-sun-hdr-gainmap": "bun scripts/validate-nokia-sun-hdr-gainmap.ts",
    "validate:nokia-stereo-pairs": "bun scripts/validate-nokia-stereo-pairs.ts",
    "validate:iso-hevc-422": "bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-444": "HEVC_ISO_VECTOR=444 bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-444-all": "HEVC_ISO_VECTOR=444 HEVC_ISO_ALL_FRAMES=1 bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-rotation": "HEVC_ISO_VECTOR=444 HEVC_ISO_REXT_ROTATION=1 bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-context": "HEVC_ISO_VECTOR=444 HEVC_ISO_REXT_CONTEXT=1 bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-rdpcm": "HEVC_ISO_VECTOR=444 HEVC_ISO_REXT_RDPCM=1 bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-rice": "HEVC_ISO_VECTOR=444 HEVC_ISO_REXT_RICE=1 bun scripts/validate-iso-23008-8.ts",
    "validate:iso-hevc-extprec": "HEVC_ISO_VECTOR=444 HEVC_ISO_ARCHIVE_MEMBER=RExt/EXTPREC_MAIN_444_16_INTRA_12BIT_RExt_Sony_1.zip HEVC_ISO_ALL_FRAMES=1 HEVC_ISO_REXT_EXTENDED_PRECISION=1 bun scripts/validate-iso-23008-8.ts",
    "prepare": "tsc",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "ts-jpeg": "^0.3.1",
    "typescript": "^5.9.3"
  }
}
